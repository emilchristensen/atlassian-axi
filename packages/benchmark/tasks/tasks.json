{
  "note": "Representative task set. kind=read tasks run live (read-only). kind=write-probe tasks target guaranteed-nonexistent items (NOPE-99999, page id 99999999999, space NOPESPACE) so they can never mutate the live site; they capture each surface's error/validation behaviour. kind=unsupported-probe runs a command the surface does not have, to capture the measured error proving the gap.",
  "site": "example.atlassian.net (redacted; a live corporate Confluence/Jira Cloud site)",
  "tasks": [
    {
      "id": "J1",
      "product": "jira",
      "title": "View a work item",
      "kind": "read",
      "commands": {
        "jira-axi": ["workitem", "view", "TEAM-43"],
        "acli": ["jira", "workitem", "view", "TEAM-43"]
      },
      "mcp": { "tool": "getJiraIssue", "note": "derived-from-docs; not drivable here" }
    },
    {
      "id": "J2",
      "product": "jira",
      "title": "Read the comments on a work item",
      "kind": "read",
      "commands": {
        "jira-axi": ["workitem", "view", "TEAM-43", "--comments"],
        "acli": ["jira", "workitem", "comment", "list", "TEAM-43"]
      },
      "mcp": { "tool": "getJiraIssue (comment field)", "note": "derived-from-docs; no dedicated comment-list tool is documented" }
    },
    {
      "id": "J3",
      "product": "jira",
      "title": "JQL search",
      "kind": "read",
      "commands": {
        "jira-axi": ["workitem", "search", "project = TEAM AND summary ~ \"scratch\" ORDER BY key ASC"],
        "acli": ["jira", "workitem", "search", "--jql", "project = TEAM AND summary ~ \"scratch\" ORDER BY key ASC"]
      },
      "mcp": { "tool": "searchJiraIssuesUsingJql", "note": "derived-from-docs; not drivable here" }
    },
    {
      "id": "J4",
      "product": "jira",
      "title": "Transition a work item (error probe on nonexistent key)",
      "kind": "write-probe",
      "commands": {
        "jira-axi": ["workitem", "transition", "NOPE-99999", "--to", "Done"],
        "acli": ["jira", "workitem", "transition", "--key", "NOPE-99999", "--status", "Done", "--yes"]
      },
      "mcp": { "tool": "transitionJiraIssue", "note": "derived-from-docs; not drivable here" }
    },
    {
      "id": "J5",
      "product": "jira",
      "title": "Add a comment (error probe on nonexistent key)",
      "kind": "write-probe",
      "commands": {
        "jira-axi": ["workitem", "comment", "NOPE-99999", "--body", "benchmark probe"],
        "acli": ["jira", "workitem", "comment", "create", "--key", "NOPE-99999", "--body", "benchmark probe", "--yes"]
      },
      "mcp": { "tool": "addCommentToJiraIssue", "note": "derived-from-docs; not drivable here" }
    },
    {
